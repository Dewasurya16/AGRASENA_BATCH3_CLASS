# =========================================================================
# KONFIGURASI BOT WHATSAPP AGRASENA BATCH 4 (KEJAKSAAN RI)
# Salin file ini menjadi .env pada server hosting / lokal Anda
# =========================================================================

# Port Server HTTP Express (Default: 5000)
PORT=5000

# Kredensial Database Supabase Website Diklat
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-anon-key

# Token Pengaman Komunikasi Website -> Bot (Wajib diisi rahasia)
BOT_SECRET_KEY=agrasena_prakom_super_secret_bot_key_2026

# Target WhatsApp Group ID (JID)
# Contoh format: 120363294829104829@g.us
# Jika belum tahu, biarkan kosong; bot akan otomatis mencetak ID grup saat di-invite ke grup WA
TARGET_GROUP_JID=

# URL Portal Web Resmi Batch 4
PORTAL_URL=https://agrasena-batch-3-class.vercel.app/batch-4

# Konfigurasi Zoom Virtual Batch 4 (Opsional jika ingin di-broadcast via bot)
# ZOOM_MEETING_ID=
# ZOOM_MEETING_ID_DISPLAY=
# ZOOM_PASSCODE=
# ZOOM_JOIN_URL=

# Tanggal Mulai Diklat Batch 4 (Format YYYY-MM-DD, Default: 2026-09-28)
# BATCH4_START_DATE=2026-09-28

# AI API Key (Groq disarankan untuk respon super cepat dan pintar)
# Bot mendukung 2+ API keys untuk rotasi otomatis / load balancing anti-limit:
GROQ_API_KEY=
GROQ_API_KEY_2=
OPENROUTER_API_KEY=

# Zona Waktu
TIMEZONE=Asia/Jakarta

# Jadwal Cron Pengingat Otomatis
# 40 7 * * * = Jam 07:40 WIB (Reminder Kelas Pagi)
SCHEDULE_REMINDER_CRON=40 7 * * *

# 0 15 * * * = Jam 15:00 WIB (Notifikasi Kelas Selesai & Tugas)
TASK_REMINDER_CRON=0 15 * * *
